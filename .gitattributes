# Auto-detect text files and enforce LF
* text=auto eol=lf

# Source code, configs & docs
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Shell & Windows scripts
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets & archives
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.tgz binary
