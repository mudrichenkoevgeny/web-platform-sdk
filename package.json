{
  "name": "web-platform-sdk-root",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev:client": "pnpm --filter @web-platform-sdk/sample-client-app dev",
    "dev:management": "pnpm --filter @web-platform-sdk/sample-management-app dev",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "lint": "eslint . --max-warnings 0",
    "lint:deps": "depcruise --config .dependency-cruiser.js packages samples",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter \"./packages/*\" --filter \"./samples/*\" exec vitest run --passWithNoTests",
    "test:watch": "pnpm -r --filter \"./packages/*\" --filter \"./samples/*\" exec vitest",
    "api:extract": "pnpm -r --filter \"./packages/*\" exec api-extractor run --local",
    "api:extract-ci": "pnpm -r --filter \"./packages/*\" exec api-extractor run",
    "version:patch": "pnpm -r --filter \"./packages/*\" exec npm version patch --no-git-tag-version",
    "version:minor": "pnpm -r --filter \"./packages/*\" exec npm version minor --no-git-tag-version",
    "version:set": "pnpm -r --filter \"./packages/*\" exec npm version --no-git-tag-version",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/compat": "^1.2.7",
    "@microsoft/api-extractor": "^7.52.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/jest": "^0.2.3",
    "@storybook/react-vite": "^10.6.5",
    "@storybook/test": "^8.6.15",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "catalog:",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "^4.14.0",
    "canvas": "^3.2.3",
    "chromatic": "^18.13.9",
    "dependency-cruiser": "^16.10.0",
    "eslint": "catalog:",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-tsdoc": "^0.4.0",
    "msw": "^2.7.0",
    "playwright": "latest",
    "storybook": "^10.6.5",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@mudrichenkoevgeny/shared-foundation": "catalog:"
  }
}
