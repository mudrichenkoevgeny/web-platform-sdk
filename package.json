{
  "name": "web-platform-sdk-root",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev:client": "pnpm --filter @web-platform-sdk/sample-client-app dev",
    "dev:management": "pnpm --filter @web-platform-sdk/sample-management-app dev",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter \"./packages/*\" --filter \"./samples/*\" exec vitest run --passWithNoTests",
    "test:watch": "pnpm -r --filter \"./packages/*\" --filter \"./samples/*\" exec vitest",
    "version:patch": "pnpm -r --filter \"./packages/*\" exec npm version patch --no-git-tag-version",
    "version:minor": "pnpm -r --filter \"./packages/*\" exec npm version minor --no-git-tag-version",
    "version:set": "pnpm -r --filter \"./packages/*\" exec npm version --no-git-tag-version"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
