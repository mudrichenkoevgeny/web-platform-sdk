{
  "name": "web-platform-sdk-root",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev:client": "pnpm --filter @web-platform-sdk/sample-client-app dev",
    "dev:management": "pnpm --filter @web-platform-sdk/sample-management-app dev",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "postinstall": "node tools/scripts/sync-foundation-rules.mjs",
    "sync-foundation-rules": "node tools/scripts/sync-foundation-rules.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:deps": "depcruise --config tools/config/dependency-cruiser.js packages samples",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter \"./packages/*\" --filter \"./samples/*\" exec vitest run --passWithNoTests",
    "test:watch": "pnpm -r --filter \"./packages/*\" --filter \"./samples/*\" exec vitest",
    "test:e2e": "playwright test",
    "api:extract": "pnpm -r --filter \"./packages/*\" exec api-extractor run --local",
    "api:extract-ci": "pnpm -r --filter \"./packages/*\" exec api-extractor run",
    "version:patch": "pnpm -r --filter \"./packages/*\" exec npm version patch --no-git-tag-version",
    "version:minor": "pnpm -r --filter \"./packages/*\" exec npm version minor --no-git-tag-version",
    "version:set": "pnpm -r --filter \"./packages/*\" exec npm version --no-git-tag-version",
    "change": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "audit": "pnpm audit --audit-level critical",
    "deps:check": "pnpm outdated",
    "deps:upgrade": "pnpm update --interactive --latest",
    "size": "size-limit",
    "lint:exports": "pnpm -r --filter \"./packages/*\" exec publint",
    "docs:generate": "node tools/scripts/generate-docs.mjs",
    "generate": "plop --plopfile tools/generators/plopfile.mjs",
    "generate:usecase": "plop --plopfile tools/generators/plopfile.mjs usecase",
    "generate:component": "plop --plopfile tools/generators/plopfile.mjs component",
    "sandbox:dev": "pnpm --filter @web-platform-sdk/sandbox dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@chromatic-com/storybook": "latest",
    "@eslint/compat": "^1.2.7",
    "@microsoft/api-extractor": "^7.52.0",
    "@playwright/test": "^1.50.0",
    "@size-limit/file": "^11.1.6",
    "@storybook/addon-a11y": "^8.6.15",
    "@storybook/addon-docs": "^8.6.15",
    "@storybook/addon-mcp": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@types/node": "catalog:",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "^4.14.0",
    "canvas": "^3.2.3",
    "chromatic": "^18.13.9",
    "dependency-cruiser": "^16.10.0",
    "eslint": "catalog:",
    "eslint-plugin-storybook": "^0.11.3",
    "eslint-plugin-tsdoc": "^0.4.0",
    "msw": "^2.7.0",
    "plop": "^4.0.1",
    "publint": "^0.3.9",
    "size-limit": "^11.1.6",
    "storybook": "^8.6.15",
    "typedoc": "^0.27.9",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "typescript-v5": "npm:typescript@5.8.3",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@mudrichenkoevgeny/shared-foundation": "catalog:"
  },
  "size-limit": [
    {
      "name": "core-common",
      "path": "packages/core-common/dist/index.js",
      "limit": "70 KB"
    },
    {
      "name": "core-security",
      "path": "packages/core-security/dist/index.js",
      "limit": "70 KB"
    },
    {
      "name": "core-settings",
      "path": "packages/core-settings/dist/index.js",
      "limit": "70 KB"
    },
    {
      "name": "core-storage",
      "path": "packages/core-storage/dist/index.js",
      "limit": "40 KB"
    },
    {
      "name": "feature-user",
      "path": "packages/feature-user/dist/index.js",
      "limit": "150 KB"
    },
    {
      "name": "feature-clientuser",
      "path": "packages/feature-clientuser/dist/index.js",
      "limit": "160 KB"
    },
    {
      "name": "feature-managementuser",
      "path": "packages/feature-managementuser/dist/index.js",
      "limit": "180 KB"
    }
  ]
}
