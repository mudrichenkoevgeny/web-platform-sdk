{
  "name": "@mudrichenkoevgeny/web-platform-sdk-tools",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "bin",
    "scripts",
    "generators",
    ".agent/global"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "import": "./dist/eslint/index.js",
      "default": "./dist/eslint/index.js"
    },
    "./depcruise": {
      "types": "./dist/depcruise/index.d.ts",
      "import": "./dist/depcruise/index.js",
      "default": "./dist/depcruise/index.js"
    },
    "./generators/*": "./generators/*",
    "./scripts/*": "./scripts/*"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "bin": {
    "sync-agent-rules": "./scripts/postinstall.mjs",
    "web-sdk-tools": "./bin/cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mudrichenkoevgeny/web-platform-sdk.git"
  },
  "dependencies": {
    "@mudrichenkoevgeny/shared-foundation": "catalog:",
    "@typescript-eslint/utils": "^8.26.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "plop": "^4.0.1",
    "publint": "^0.3.9",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
